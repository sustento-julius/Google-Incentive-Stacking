# --- AI generation (optional) ---
# Used for the newsletter prose + "Translation From Government" rewriting.
# Without a key, 3 Mins Local falls back to deterministic templates and still
# produces a complete newsletter.
GEMINI_API_KEY=""

# Model used for generation. gemini-2.0-flash is fast + cheap and works well.
TML_LLM_MODEL="gemini-2.0-flash"

# --- Transcription (optional) ---
# Whisper backend to use when a meeting has video but no CART transcript.
# One of: faster-whisper | openai-whisper
TML_WHISPER_BACKEND="faster-whisper"
TML_WHISPER_MODEL="base"
